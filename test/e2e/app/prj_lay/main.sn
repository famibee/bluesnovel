; E2E用シナリオ（lay.e2e.ts が使用）
;	[lay]のレイヤ共通属性と[clear_lay]は、エンジンが積むアクション（ユニット側で検証済み）が
;	最終的にCSSへ落ちるかどうかが本題なので、ここでは算出スタイルを見る
;	重なり順は[add_lay]した順＝配列・DOMの並び（後ろほど手前）なので、base -> mes の順で作る
[add_lay layer=base class=grp]
[add_lay layer=mes class=txt]
[current layer=mes]

きほん[p]

; レイヤ共通の見た目をまとめて指定
[lay layer=mes left=40 top=80 alpha=0.5 rotation=30 scale_x=2 scale_y=0.5]
[lay layer=mes b_color=0xFF8000 b_alpha=0.6]
うごいた[p]

; style属性は既定スタイルを後ろから上書きする
[lay layer=mes style="letter-spacing: 4px;"]
すたいる[p]

[lay layer=mes visible=false]
きえた[p]

; 回転原点（pivot）と合成モード
[lay layer=mes visible=true pivot_x=50 pivot_y=80 blendmode=multiply]
ぴぼっと[p]

; 重なり順。add_lay順に base -> mes なので mes が手前。[lay float=true]で base を最前面へ
[lay layer=base float=true]
まえへ[p]

; フィルター。[add_filter]は重ね、[enable_filter]で個別に効き目を切り替える
[add_filter layer=mes filter=sepia]
[add_filter layer=mes filter=blur strength=3]
ふぃるた[p]

[enable_filter layer=mes index=1 enabled=false]
きった[p]

; [er]は変形まわり（alpha/blendmode/pivot/角度/拡縮）を既定へ戻すが、
;	**位置とvisibleと見た目（style/b_color）には触らない**（本家 Layer.ts:420）
[lay layer=mes alpha=0.4 rotation=30 scale_x=2 scale_y=2 pivot_x=5 pivot_y=6 blendmode=screen]
[lay layer=mes left=40 top=50 style="letter-spacing: 3px;"]
まわす[p]
[er]
もどった[p]

; [clear_lay]で見た目は初期値へ、中身（文字・ボタン）も捨てる。visibleだけは触らない
[lay layer=mes visible=false]
[clear_lay layer=mes page=fore]
[p]

; 背景が完全に透明（b_alpha=0）な層は、文字があっても箱（背景＋点線枠）を描かない。
;	テンプレの[txt_lay_fullscreen b_alpha=0]がこの形（b_colorは書くが透過度は0）
[lay layer=mes visible=true b_color=0xFF8000 b_alpha=0]
とうめい[s]
