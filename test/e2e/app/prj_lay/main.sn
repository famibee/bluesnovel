; E2E用シナリオ（lay.e2e.ts が使用）
;	[lay]のレイヤ共通属性と[clear_lay]は、エンジンが積むアクション（ユニット側で検証済み）が
;	最終的にCSSへ落ちるかどうかが本題なので、ここでは算出スタイルを見る
;	重なり順は[add_lay]した順＝配列・DOMの並び（後ろほど手前）なので、base -> mes の順で作る
[add_lay layer=base class=grp]
[add_lay layer=mes class=txt]
[current layer=mes]

きほん[p]

; レイヤ共通の見た目をまとめて指定
[lay layer=mes left=40 top=80 alpha=0.5 rotation=30 scale_x=2 scale_y=0.5]
[lay layer=mes b_color=0xFF8000 b_alpha=0.6]
うごいた[p]

; style属性は既定スタイルを後ろから上書きする
[lay layer=mes style="letter-spacing: 4px;"]
すたいる[p]

[lay layer=mes visible=false]
きえた[p]

; 回転原点（pivot）と合成モード
[lay layer=mes visible=true pivot_x=50 pivot_y=80 blendmode=multiply]
ぴぼっと[p]

; 重なり順。add_lay順に base -> mes なので mes が手前。[lay float=true]で base を最前面へ。
;	mesにボタンを乗せておく：BtnLayer.tsx のボタンは`position: relative; z-index: 2`を持つため、
;	TxtLayer側でその漏れを閉じ込めていないと、[lay float=]で他レイヤを前面へ動かしてもボタンだけが
;	z-indexで最前面に居座り続けてしまう回帰の確認（todo.md 2026-08-20の[lay float=true]不具合）。
;	alpha=1・blendmode=normalに戻しておく：opacity<1やmix-blend-mode!=normalはそれ自体がCSSの
;	スタッキングコンテキストを作ってしまい、上のz-index漏れをたまたま閉じ込めてしまうため
;	（本題はalpha/blendmodeとも既定のレイヤで再現する不具合）
[lay layer=mes alpha=1 blendmode=normal]
[button layer=mes page=fore text=ぼたん label=*btn_zorder]
[lay layer=base left=0 top=0 width=800 height=600 float=true]
まえへ[p]

; フィルター。[add_filter]は重ね、[enable_filter]で個別に効き目を切り替える
[add_filter layer=mes filter=sepia]
[add_filter layer=mes filter=blur strength=3]
ふぃるた[p]

[enable_filter layer=mes index=1 enabled=false]
きった[p]

; [er]は変形まわり（alpha/blendmode/pivot/角度/拡縮）を既定へ戻すが、
;	**位置とvisibleと見た目（style/b_color）には触らない**（本家 Layer.ts:420）
[lay layer=mes alpha=0.4 rotation=30 scale_x=2 scale_y=2 pivot_x=5 pivot_y=6 blendmode=screen]
[lay layer=mes left=40 top=50 style="letter-spacing: 3px;"]
まわす[p]
[er]
もどった[p]

; [clear_lay]で見た目は初期値へ、中身（文字・ボタン）も捨てる。visibleだけは触らない
[lay layer=mes visible=false]
[clear_lay layer=mes page=fore]
[p]

; 背景が完全に透明（b_alpha=0）な層は、文字があっても箱（背景＋点線枠）を描かない。
;	テンプレの[txt_lay_fullscreen b_alpha=0]がこの形（b_colorは書くが透過度は0）
[lay layer=mes visible=true b_color=0xFF8000 b_alpha=0]
とうめい[p]

; [lay back_clear=true]：背景（b_color/b_alpha/b_alpha_isfixed/b_pic）を初期状態へ戻す
[lay layer=mes b_color=0x0000FF b_alpha=1 b_alpha_isfixed=true]
はいけい[p]
[lay layer=mes back_clear=true]
けした[p]

; 画像レイヤの寸法（[lay width=/height=]）。div0の箱サイズとして出る
;	（画像そのものの拡縮はアセットが要るのでpic.e2e.ts側で見る）
[lay layer=base width=120 height=90]
がぞうわく[p]

; 片方だけの指定なら他方はheightキー自体を持たない＝自然サイズ（auto）のまま
;	（本家GrpLayer.ts:88-91の潰れバグは踏襲しない）。既存レイヤは現在値を維持するだけなので
;	検証にならない → 新規レイヤで確かめる
[add_lay layer=base3 class=grp]
[lay layer=base3 width=200]
はばだけ[p]

; b_pic（文字レイヤ背後の枠画像）の自動サイズ調整（本家 TxtLayer.ts:396-414 setMySize()相当）。
;	[lay width=/height=]の明示が無ければ、枠画像waku.pngの自然サイズ(80x40)がそのまま箱になる
;	（mesは[clear_lay]前のvisible=falseがまだ残っているので、ここで戻す。本家もclearLayはvisible不触）
[lay layer=mes visible=true b_pic=waku]
わくじどう[p]

; [lay width=/height=]の明示があればそちらが勝つ（本家の順序依存の罠は持ち込まない）
[lay layer=mes width=200 height=100]
わくめいじ[s]

; 到達しない：上の[button ... label=*btn_zorder]の飛び先を定義しておくだけ（未クリックのため実際は通らない）
*btn_zorder
[s]
