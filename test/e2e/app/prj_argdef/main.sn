; E2E用シナリオ（argdef.e2e.ts が使用）
;	**表示属性を1つも書かない**レイヤを置くだけ。
;	bluesnovelは「シナリオが書いた属性だけを格納する」方針なので、書かなかった分の既定は
;	下流のCSSが供給する。その値が本家の既定（Layer.ts の argChk_* が与える値）と
;	一致しているかは、ここで**算出値**を見るしかない
;	（test/argdef_parity.test.ts はソースの照合なのでCSS側のズレを見つけられない）
[add_lay layer=base class=grp]
[add_lay layer=mes class=txt]
[current layer=mes]

; 画像レイヤ：fnだけ。visible/alpha/left/top/rotation/scale_*は書かない
[lay layer=base fn=bg]
もじ[l]

; 配置属性（本家 Layer.ts:513-552）。**-1〜1はステージ幅・高さの割合**で、
;	center/right/middle/bottomは「指定値から表示物の幅・高さを引く」寄せ。
;	実寸はエンジンが知らないのでCSSの独立translateプロパティで表す
[add_lay layer=c class=grp]
[add_lay layer=r class=grp]
[add_lay layer=s class=grp]
[lay layer=c fn=bg center=0.5 middle=0.5]
[lay layer=r fn=bg right=0.5 bottom=0.5]
[lay layer=s fn=bg s_right=20 s_bottom=30]
よせた[s]
