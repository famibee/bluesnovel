; E2E用シナリオ（waitev.e2e.ts が使用）
;	イベント系タグは「ユーザー操作にどう反応するか」が本題なのでブラウザで見る：
;	・[enable_event enabled=false]でボタンがクリックを受けなくなること
;	・[enable_event enabled=false]の間はゲームパッド／キーボードのフォーカスも受けないこと
;	・[wait time=…]がその間シナリオを止め、クリックで打ち切れること
;	・[waitclick]はクリックで進み、[s]はクリックでは進まないこと
[add_lay layer=mes class=txt]
[current layer=mes]
[button page=fore nm=btn text=ボタン label=*btn]

; 本家 main.sn と同じ形（focus.e2e.tsのprj_frameと同じ）：矢印キーの予約から[set_focus]を呼ぶ
[event global=true call=true key=arrowright label=*fcs arg=next]
; title.snの*c2p（クリック待ちオーバーレイ）と同じ形：[enable_event enabled=false]の最中の[waitclick]
[event global=true call=true key=x label=*c2plike]

; ボタンを無効化した状態で待つ。**本文中の[link]もまとめて効かなくなる**
;	（本家は文字レイヤのコンテナごと interactiveChildren=false にする）
[enable_event enabled=false]
むこう[link label=*btn]りんく[endlink][p]

[enable_event enabled=true]
ゆうこう[p]

; ウェイト（クリックで打ち切れる）
[wait time=1500]
まった[waitclick]

; [waitclick]はクリックで進む。[s]はクリックでは進まない
とまった[s]
このさきへは進まない

*btn
[er]おされた[s]

*fcs
[set_focus to=&sn.eventArg]
[return]

*c2plike
[er]
[enable_event enabled=false]
くりっくまち[waitclick]
[er]
[enable_event enabled=true]
かいじょ[s]
