; E2E用シナリオ（button.e2e.ts が使用）
;	[button call=true]→[return] で [l] のイベント待ちへ戻ることの回帰確認を主目的とする
[add_lay layer=mes class=txt]
[current layer=mes]
[button page=fore nm=btn_call text="サブルーチンを呼ぶ" label=*sub call=true]
[button page=fore nm=btn_jump text="ジャンプする" label=*goal]
[button page=fore nm=btn_fcall text="別ファイルを呼ぶ" fn=sub2 label=*fcall call=true]
[button page=fore nm=btn_fjump text="別ファイルへ飛ぶ" fn=sub2 label=*fjump]
; 本家 theme/title.sn のタイトルボタンと同じ座標指定。left/topを書いた時だけ絶対配置になる
[button page=fore nm=btn_pos text="座標指定" left=250 top=360 width=90 height=30 rotation=15 label=*goal]
[button page=fore nm=btn_off text="無効" enabled=false label=*goal]
; ツールチップ。hint_styleは吹き出しのCSS、hint_optは本家popperのオプションJSON（placementだけ見る）
[button page=fore nm=btn_hint text="ヒント付き" label=*goal hint="せつめい" hint_style="color: rgb(0, 255, 0);" hint_opt='{"placement": "bottom"}']
; 見た目はCSSで書ける（本家はpixiのTextStyle JSON）。通常・ホバー／フォーカス中・押下中の3状態
[button page=fore nm=btn_sty text="見た目" label=*goal style="color: rgb(255, 0, 0);" style_hover="color: rgb(0, 128, 0);" style_clicked="color: rgb(0, 0, 255);"]
; ギャラリーのサンプルのようなJSON指定も主要キーだけCSSへ読み替える
[button page=fore nm=btn_sty2 text="JSON指定" label=*goal style='{"fill": "rgb(255, 0, 255)"}']
; url指定はラベルへ飛ばず別タブでURLを開く（本家 Main.ts:179。[link url=]と同じ）
[button page=fore nm=btn_url text="URLを開く" url='https://example.com/']
選んでください。[l]
; [lay visible=false]は**ボタンも隠す**。本家はボタンが文字レイヤのコンテナの子なので
;	コンテナごと消える。分家もボタン箱をレイヤベースの実子にしたことで同じ構造になった
;	（2026-09-16）。テンプレの[sys_menu visible=false]がこれ
[lay layer=mes page=fore visible=false]
[l]
[lay layer=mes page=fore visible=true alpha=0.5]
[l]
; レイヤ自体のleft/topは、座標指定ありのボタン・座標指定なしの流し込み配置の両方に効く
;	（本家はボタンがレイヤのコンテナの子なので自動追従。分家もボタン箱をレイヤベースの実子に
;	したことで橋渡し無しで追従する。2026-09-15発覚・2026-09-16構造修正）
[lay layer=mes page=fore left=300 top=200]
[l]
; rotation/scale_*もボタンへ構造的に伝播する（3層化の本題そのものの回帰確認）
[lay layer=mes page=fore rotation=20 scale_x=1.5 scale_y=1.5]
[l]
; ボタンの文字フォントは組み込み変数で差し替えられる（本家 LayerMng.ts:209。全ボタン共通）
&sn.button.fontFamily = 'monospace'
＋そのまま進んだ。[s]

*sub
＋サブ実行[return]

*goal
＋ジャンプ先[s]
