; E2E用シナリオ（pic.e2e.ts が使用）
;	画像は path.json → Config.searchPath() で解決する。ここまで一度も本物の画像を通していなかったので、
;	フィクスチャに実体（bg.png / face_a.png）を置いて経路全体を確かめる：
;	・[lay fn=…]がpath.json経由で解決され、<img>として表示されること
;	・[add_face]＋[lay face=…]の差分合成が重なること
;	・サーチパスに無い画像はデバッグ表示へエラーを出し、画面は落ちないこと
[add_lay layer=base class=grp]
[add_lay layer=mes class=txt]
[current layer=mes]

[lay layer=base fn=bg]
はいけい[p]

; 差分合成。dx/dyは親画像（fn）の左上を原点とした相対座標
[add_face name=face_a dx=5 dy=6]
[lay layer=base fn=bg face=face_a]
さぶん[p]

; サーチパスに無い画像。エラーは出るが画面は落ちない。
;	face=''で前段のface_aを明示的にクリア（face省略時は直前のfaceを維持する仕様のため。
;	本家 GrpLayer.ts:76-85＝fnは毎回明示、faceは省略可＝省略時は直前を維持）
[lay layer=base fn=nai_gazou face='']
みつからない[p]

; 合成モード。[lay]・[add_face]・[button]の3つとも本家の4種だけを受けてCSSの値へ直す
[add_face name=face_m fn=face_a dx=1 dy=2 blendmode=multiply]
[lay layer=base fn=bg face=face_m blendmode=screen]
[button layer=mes page=fore text=ぼたん label=*here blendmode=add]
ごうせい[p]

; 画像の拡縮（[lay width=/height=]）。bg.pngの自然サイズ(40x30)を80x60へ拡大する。
;	face=''で前段のface_mを明示的にクリア（省略時は維持されるため）
[lay layer=base fn=bg width=80 height=60 face='']
かくだい[p]

; pos（立ち絵配置のショートカット）。containing block右端に近い位置（pos=r）へ
;	widthを明示しない大きな画像を置いても、自然サイズのまま表示されること
;	（div0がposition:absolute×width autoだとCSSのshrink-to-fitに落ちて縮む不具合があった）
[add_lay layer=base2 class=grp]
[lay layer=base2 fn=wide pos=r]
はばひろ[s]

*here
とんだ[s]
