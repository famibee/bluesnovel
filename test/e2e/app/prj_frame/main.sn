; E2E用シナリオ（frame.e2e.ts が使用）
;	HTMLフレームは「本物のiframeを読み込んで、中のvar変数を読み書きする」ものなので
;	ブラウザでしか確かめられない。ここで見るのは：
;	・[add_frame]がHTMLを読み込み終えてからシナリオが進むこと（＋組み込み変数）
;	・[set_frame]がフレーム内のvar変数へ入り、[let_frame function=true]が関数を呼べること
;	・[frame visible=…]で出し入れできること
;	・[event key='dom=id:セレクタ']でフレーム内のボタンがラベルへ飛ばせること（＋発火した要素のdata-*）
;	・[tsy_frame]がフレームの見た目を時間をかけて動かすこと
[add_lay layer=mes class=txt]
[current layer=mes]

[add_frame id=yesno src=yesno visible=false width=400 height=200]
[event key='dom=yesno:#ok' label=*y global=true]
[event key='dom=yesno:#close' label=*cancel global=true]
; 読み込み完了で立つ組み込み変数（本家と同じ一式）
[trace text="&'frm:'+ const.sn.frm.yesno +'/'+ const.sn.frm.yesno.width +'/'+ const.sn.frm.yesno.visible"]
よみこんだ[p]

; フレーム内のvar変数へ設定し、フレーム側の関数を呼んで描画させる
[set_frame id=yesno var_name=val_dic text=こんにちは]
[let_frame id=yesno var_name=val2ctrl function=true]
[frame id=yesno visible=true]
ひょうじ[p]

; [let_frame]で取った値は同じ停止点までの間に読める
[trace text="&'ret:'+ const.sn.frm.yesno.val2ctrl"]
とれた[p]

; [tsy_frame]：フレームの見た目を時間をかけて動かす。[tsy]と同じ仕組みだが、
;	動かす先はストアのレイヤではなくFrameMngが抱えるiframe。x/yはレイヤのleft/topに当たる
[tsy_frame id=yesno time=400 x='=100' alpha=0.5]
[wait_tsy id=yesno]
うごかした[p]

; [set_focus]。[button]は表示中ずっと輪に居る。フレーム内の要素は
;	[event key='dom=…']の最初の1件が自動で入り、[set_focus add=…]でも足せる
[button page=fore nm=b1 text=ボタン1 label=*b1]
[button page=fore nm=b2 text=ボタン2 label=*b2]
[set_focus add='dom=yesno:#close']
; 本家 main.sn と同じ形：矢印キーの予約から[set_focus to=&sn.eventArg]を呼ぶ
[event global=true call=true key=arrowright label=*fcs arg=next]
[event global=true call=true key=arrowleft label=*fcs arg=prev]
[event global=true call=true key=escape label=*fcs arg=null]
ふぉーかす[l]

; ゲームパッド対応（FocusMng種別ごとのキー処理）の確認用：range/text/radio/checkboxを
;	フォーカスの輪へ追加する。**[p]（下のえをだした）より前**に置くこと：[p]は「次の進行時に
;	現在レイヤをクリア」する仕様で、その「次の進行」は[set_focus to=…]を呼ぶ[event]
;	（ArrowRight等）でも起きるため、[p]の後ろに続けるとテキストが消えてしまう
[set_focus add='dom=yesno:#range1,#text1,#radio_grp,#chk1']
ぱっど[l]

; フレーム内の<img data-src=…>の解決（本家 FrameMng.ts:154 → #loadPic2Img）。
;	**まずプロジェクトのパス解決（path.json）へ通す**。テンプレのアルバムは解放済み項目の
;	data-srcに`F_kuchimoto`のような拡張子なしのアセット名を書くので、枠のディレクトリを
;	前置するだけでは404になる（＝アルバムで絵がリンク切れになっていた）
[let_frame id=yesno var_name=draw_pics function=true]
えをだした[p]

; [frame disabled=true]：<input>/<select>だけでなく<button>もdisabledになる
;	（右クリックメニューのボタンがdisabled中もフォーカスの輪に残る不具合の再発防止）
[frame id=yesno disabled=true]
むこうにした[p]
[frame id=yesno disabled=false]
もどした[p]

; フレームを隠すと、その中の要素は輪から飛ばされる（[frame visible=false]）。
;	range1等もフレーム内なので#ok/#closeと同じく輪から飛ばされる
[frame id=yesno visible=false]
かくした[s]

*fcs
[set_focus to=&sn.eventArg]
[return]

*y
; 発火した要素の data-* が sn.event.domdata.* に入っている
[er]&'おっけー:'+ sn.event.domdata.sel + sn.event.domdata.num&[s]

*cancel
[er]きゃんせる[s]

*b1
[er]ぼたん1[s]

*b2
[er]ぼたん2[s]
