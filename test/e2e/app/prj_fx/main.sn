; 立ち絵シェーダエフェクト（[add_fx]/[clear_fx]）の回帰確認用（fx.e2e.ts）。
;	見るのは「基本画像 <img> ↔ WebGL <canvas> の差し替え seam」と、
;	aFx が A_LAY_STY_KEY 経由で [clear_lay]・page=both 複製へ追随するか。
;	WebGL の描画結果そのもの（波形・ずれ量）はヘッドレスの GL 実装差が大きいので見ない
;	（絵の手動確認は playwright-cli スキルで）。
;	各ステップの手前で [er]（文字レイヤだけ消す。grp には触れない）してから本文を出す。
[add_lay layer=base class=grp]
[add_lay layer=mes class=txt]
[current layer=mes]

[lay layer=base fn=pic left=120 top=40 scale_x=3 scale_y=3]
そのまま[l]

[add_fx layer=base fx=wave amp=10 freq=3]
[er]wave[l]

[add_fx layer=base name=rgb fx=rgbShift shift=12]
[er]wave+rgb[l]

[clear_fx layer=base name=rgb]
[er]waveのみ[l]

[add_fx layer=base page=both name=both fx=wave amp=4]
[er]both[l]

[clear_lay layer=base]
[lay layer=base fn=pic left=120 top=40 scale_x=3 scale_y=3]
[er]clear_lay後[l]

[add_fx layer=base fx=rgbShift time=1500 shift=20]
[er]oneshot[l]

[clear_fx layer=base]
[er]ぜんぶクリア[l]

; [wait_fx]：[add_fx time>0] の経過待ち（ScriptMng がタイマーを持つ。[wait_tsy] と同形）
[lay layer=base fn=pic left=120 top=40 scale_x=3 scale_y=3]
[add_fx layer=base name=short fx=rgbShift time=400 shift=8]
[wait_fx layer=base name=short]
[er]wait_fx完了[l]

; [pause_fx]/[resume_fx]：記述子の enabled が反転する（rAF 停止/再開そのものは playwright-cli で手動確認）
[add_fx layer=base name=p fx=wave]
[pause_fx layer=base name=p]
[er]pause_fx[l]
[resume_fx layer=base]
[er]resume_fx[l]

; [def_fx] で定義したユーザープリセットを [add_fx fx=] で使う（HEAD は自動前置＝main() だけ書く。
;	契約は [trans glsl=] と統一：uSampler / vTextureCoord / tick）。GLSL 本体は aFx に焼かれない
[clear_fx layer=base]
; 汎用入力ポート（p1〜p4 / color）も一緒にコンパイル回帰させる（値の反映は playwright-cli で確認）
[def_fx name=pulse glsl="uniform float p1;uniform vec3 color;void main(){vec4 s=texture2D(uSampler,vTextureCoord);gl_FragColor=vec4(mix(s.rgb,color,p1)*(0.6+0.4*sin(tick)),s.a);}"]
[add_fx layer=base name=g fx=pulse p1=0.3 color=0x3366ff]
[er]def_fx[l]

; 静止 face 差分を fx のテクスチャへ合成（offscreen 2D canvas。sheet/動画は未対応＝DOMのまま）。
;	pic.png 自身を face に使う（別アセット不要）。合成されれば face の <img data-fn> は DOM から消える
[clear_fx layer=base]
[add_face name=f fn=pic dx=30 dy=20]
[lay layer=base fn=pic face=f]
[add_fx layer=base fx=wave]
[er]face合成[l]

; [trans] 後の不可視 back ページで fx の rAF を止める（可視＝表ページ or trans中 のときだけ回す）。
;	canvas の data-fx-running（0/1）で確認する
[clear_fx layer=base]
[lay layer=base fn=pic left=120 top=40 scale_x=3 scale_y=3]
[lay layer=base fn=pic left=120 top=40 scale_x=3 scale_y=3 page=back]
[add_fx layer=base page=both fx=wave]
[er]trans前[l]
[trans time=300]
[wt]
[er]trans後[l]

; 天候プリセット（snow / rain。背景向け）。2 本重ねて ping-pong を通す＝GLSL コンパイル回帰
[clear_fx layer=base]
[add_fx layer=base name=sn fx=snow]
[add_fx layer=base name=rn fx=rain amp=2]
[er]天候[l]

; アニメ png シートの face を fx のテクスチャへ毎フレーム転写（GrpLayer makeFxSource が関数を返す）。
;	合成されるので face の DOM オーバーレイ（div[data-fn]）は出ない
[clear_fx layer=base]
[add_face name=af fn=anime dx=8 dy=8]
[lay layer=base fn=pic face=af]
[add_fx layer=base fx=wave]
[er]sheet_face[l]

; 動画レイヤを fx のテクスチャへ（GrpLayer makeFxSource が React 所有の <video> を毎フレーム転写）。
;	<video data-fn> は DOM に残す（[wv]・音量制御の担当）。canvas がその上に重なる
[clear_fx layer=base]
[lay layer=base fn=movie face=""]
[add_fx layer=base fx=wave]
[er]movie_base[l]

; 動画 face を fx へ合成（makeFxSource が detached な <video> を毎フレーム転写）。
;	合成されるので face の DOM オーバーレイ（video[data-fn] 等）は出ない
[clear_fx layer=base]
[lay layer=base fn=pic face=""]
[add_face name=mf fn=movie dx=4 dy=4]
[lay layer=base fn=pic face=mf]
[add_fx layer=base fx=wave]
[er]movie_face[l]

; アニメ png シートを基本画像に持つレイヤへ fx（従来は FxImg を出さなかった＝条件を緩めた）
[clear_fx layer=base]
[lay layer=base fn=anime face=""]
[add_fx layer=base fx=wave]
[er]sheet_base[s]
