; E2E用シナリオ（snap.e2e.ts が使用）
;	システム系のDOM絡みタグ3つ：
;	・[loadplugin]……cssを読んで<style>としてページへ足す（join=trueなので読み終わるまで待つ）
;	・[snapshot]………ステージをpngにしてダウンロードさせる
;	・[navigate_to]…別タブでURLを開く
[add_lay layer=base class=grp]
[add_lay layer=mes class=txt]
[current layer=mes]

[lay layer=base fn=bg]
[loadplugin fn=/test/e2e/app/prj_snap/plugin.css]
よみこんだ[p]

[snapshot fn=e2e_shot]
とった[p]

; fnを`userdata:/`で始めるとダウンロードでなく**セーブ層**へ入る（本家はセーブデータと同じ
;	フォルダへ実ファイル）。日時が付かないので、しおり画面が同じ名前で読み返せる
[snapshot fn='userdata:/thumb.png' width=80 height=60]
[lay layer=base fn='userdata:/thumb.png']
しまった[p]

; 出力フォーマットは拡張子で決まる（ダウンロード側も。本家は常にpngだった）
[snapshot fn=e2e_shot.jpg]
じぇいぺぐ[p]

[navigate_to url=https://example.com/]
ひらいた[s]
