{
	"name": "@famibee/bluesnovel",
	"version": "0.2.0",
	"description": "js novelgame framework",
	"author": "miyazawa famibee",
	"publisher": "famibee",
	"homepage": "http://famibee.blog38.fc2.com/",
	"license": "MIT",
	"main": "./dist/web.js",
	"types": "./dist/web.d.ts",
	"type": "module",
	"files": [
		"dist",
		"dist_app"
	],
	"engines": {
		"node": ">=22.19"
	},
	"exports": {
		".": {
			"types": "./dist/web.d.ts",
			"default": "./dist/web.js"
		},
		"./web": {
			"types": "./dist/web.d.ts",
			"default": "./dist/web.js"
		},
		"./appMain": {
			"types": "./dist/appMain.d.ts",
			"default": "./dist_app/appMain.js"
		},
		"./preload": {
			"types": "./dist/preload.d.ts",
			"default": "./dist_app/preload.js"
		},
		"./app": {
			"types": "./dist/app.d.ts",
			"default": "./dist_app/app.js"
		}
	},
	"dependencies": {
		"@electron-toolkit/typed-ipc": "^1.0.2",
		"@emotion/react": "^11.14.0",
		"adm-zip": "^0.6.0",
		"electron-store": "^11.0.2",
		"fs-extra": "^11.4.0",
		"gsap": "^3.15.0",
		"parsimmon": "^1.18.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-moveable": "^0.56.0",
		"react-use": "^17.6.1",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.0",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@types/bun": "^1.3.14",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^26.1.1",
		"@types/parsimmon": "^1.10.9",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/typescript6": "^6.0.2",
		"electron": "^43.2.0",
		"eslint": "^10.8.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jest": "^29.16.0",
		"globals": "^17.7.0",
		"jiti": "^2.7.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5"
	},
	"scripts": {
		"build": "bun src/build.ts",
		"watch": "bun --watch src/build.ts --watch",
		"update": "bun update && bun watch && ncu -g",
		"test": "bun test --only-failures",
		"testw": "bun test --only-failures --watch",
		"test:e2e": "playwright test -c test/e2e",
		"test:e2e:ui": "playwright test -c test/e2e --ui",
		"docs": "vite docs/ --open /tag.html",
		"rebuild": "bun pm cache rm && bun watch"
	},
	"keywords": [
		"novelgame",
		"visualnovel",
		"bluesnovel",
		"esm",
		"javascript",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/famibee/bluesnovel.git"
	},
	"release": {
		"plugins": [
			[
				"@semantic-release/commit-analyzer",
				{
					"preset": "conventionalcommits"
				}
			],
			[
				"@semantic-release/release-notes-generator",
				{
					"preset": "conventionalcommits"
				}
			],
			"@semantic-release/changelog",
			"@semantic-release/npm",
			"@semantic-release/github",
			"@semantic-release/git"
		]
	},
	"publishConfig": {
		"scope": "@famibee",
		"tag": "latest",
		"access": "public",
		"provenance": true
	},
	"bugs": {
		"url": "https://github.com/famibee/bluesnovel/issues",
		"email": "famibee@gmail.com"
	}
}
